# Copy to .env and fill in — NEVER commit the real .env file.

# Optional — HTTP port the server listens on. Defaults to 3001.
PORT=

# Optional — local SQLite file path, only used when TURSO_DATABASE_URL/
# TURSO_AUTH_TOKEN below are unset. Defaults to server/humfiverse.db.
DB_PATH=

# Optional — base URL used to build the ERC-1155 token-metadata endpoint's
# absolute URLs (GET /api/token-metadata/:id.json's image field, etc. —
# see §2.36). Defaults to the production Render URL; override for a local
# backend if you need wallets/tools to fetch metadata from it directly.
TOKEN_METADATA_BASE=

# Optional — where the database lives (see db.js). Leave both unset for
# local dev: falls back to a local SQLite file (server/humfiverse.db),
# no Turso account needed. Set both to point at a real Turso (libSQL)
# database instead — this is what makes data survive a Render redeploy
# (§2.23; Render's free tier has no persistent disk, see §2.18).
# Create a database with: turso db create humfiverse
# Get the URL with:       turso db show humfiverse --url
# Get a token with:       turso db tokens create humfiverse
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Required for POST /api/onchain/mint to work. Must be the private key of
# the wallet that owns HumfiverseCatalogueToken on Sepolia (see
# contracts/.env.example — same key). Testnet-only throwaway key, never
# real funds. Without this set, on-chain minting is disabled but the rest
# of the API still works.
CHAIN_OPERATOR_PRIVATE_KEY=

# Optional — defaults shown are what's already deployed (redeployed §2.42
# to link the two contracts together — see below). Use your own Alchemy (or
# similar) RPC URL; the public default has repeatedly proven unreliable
# (§2.39) — this is just a fallback, not a recommendation to actually run on it.
CHAIN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CHAIN_CONTRACT_ADDRESS=0xa619aCD77D2540a38a2B95FFb051357a921082EF
CHAIN_CONTRACT_DEPLOY_BLOCK=11724392

# Optional — HumfiverseMilestoneEscrow.sol address (see chainEscrow.js).
# Same CHAIN_OPERATOR_PRIVATE_KEY above is used for its owner-gated calls.
# §2.42: this contract is now deployed with the catalogue token's address
# baked in at construction, and the token has this contract's address
# authorized via setEscrowContract — so contribute() can release tokens
# from the token's pool atomically. Deploying a new escrow means deploying
# a new token too (or re-authorizing an existing one), never one alone.
CHAIN_ESCROW_ADDRESS=0xc0043d41693D7E4DF0785bd3c28e619a543FD368
# Block the escrow contract above was deployed at — event-log scans start
# here instead of block 0 (see listRecentlyCreatedCampaignAssetIdsFromChain in chainEscrow.js).
CHAIN_ESCROW_DEPLOY_BLOCK=11724393
# Optional (§2.71) — the escrow the current one replaced. Read-only: a
# campaign the current escrow has no record of is looked up here, so a
# campaign that finished on the old contract keeps its real history instead
# of being recreated as unfunded. Leave empty if nothing finished there.
# §2.96: honest-man-595 and new-song-464 finished on this one.
CHAIN_ESCROW_LEGACY_ADDRESS=0x16C8bfE861Ef1B102CD6D6a4FD4e881FdD38721c

# Required for POST /api/onchain/audio/:assetId to work (§2.43) — pins the
# uploaded track's audio file to IPFS via Pinata's API, then the CID is
# written on-chain (HumfiverseCatalogueToken.setTrackAudioUri). Create a
# free account at pinata.cloud, then API Keys → New Key → enable
# pinFileToIPFS → copy the JWT shown (shown once). Without this set, audio
# upload is disabled but the rest of the API still works.
PINATA_JWT=

# Required for DELETE /api/assets/:id (admin cleanup, §2.22) — Humfiverse
# no longer has any milestone-confirm endpoint to gate (§2.27 removed it;
# release now requires the artist's and studio's own wallets). Callers
# must send this back as the X-Admin-Key header. Without it set, the
# gated endpoint is disabled (fails closed, not open) — see
# planning/technical-architecture.md §2.21.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_API_KEY=

# Required for the secondary-market resale board (§2.59) —
# HumfiverseMarketplace.sol's address. Without it the board reports itself
# as unavailable rather than showing an empty list as though nobody were
# selling. Deploy with:
#   cd contracts && npx hardhat run scripts/deployMarketplace.js --network sepolia
# Unlike every other contract change this project has made, this one needs
# NO redeploy of HumfiverseCatalogueToken or HumfiverseMilestoneEscrow: the
# marketplace reaches the token through the plain IERC1155 interface and is
# authorised per-seller by their own setApprovalForAll, never by Humfiverse.
# §2.73: every contract above takes Circle's Sepolia USDC; nothing to configure
# for it here — the server and the wallet read paymentToken() off each contract.
CHAIN_MARKETPLACE_ADDRESS=0x755500dEB66169fC605Be8Aa25ACBdAd791F1585

# §2.83 — signs the JWTs that open a thirdweb in-app wallet from an identity
# this backend verified itself (the EU Digital Identity Wallet path). Only
# the public key is served, at GET /api/auth/jwks.json — enter that URL as
# the JWKS URI under "Custom JWT" in the thirdweb dashboard, with the same
# audience as AUTH_JWT_AUDIENCE. Nothing signs with it until the EUDIW
# verifier exists. Leave empty to disable (the endpoint answers 503).
# Generate: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | awk 'NF {printf "%s\\n", $0}'
# A secret like the operator key: never commit a real one.
AUTH_JWT_PRIVATE_KEY=
AUTH_JWT_ISSUER=https://humfiverse-api.onrender.com
AUTH_JWT_AUDIENCE=humfiverse-wallet

# §2.93 — registration with a verified email. Codes are sent through Brevo
# (brevo.com, free plan: 300 emails/day). Create an API key under
# SMTP & API → API Keys, and verify the sender address under Senders.
# While these are empty, registration is neither possible nor required.
# EMAIL_DEV_LOG=1 prints the codes to the console instead: local runs only,
# never on Render.
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Humfiverse
EMAIL_DEV_LOG=

# §2.100 — the guide widget's free-text answers. Leave ANTHROPIC_API_KEY
# empty and the widget still works: it answers from the written topics it
# ships with, says so in its header, and nothing is ever sent to Anthropic.
# Set it (console.anthropic.com → API keys) and typed questions are answered
# by the Messages API, with server/assistant-knowledge.js as the brief.
# Billed per message, from an endpoint that needs no sign-in — keep the caps
# in mind: 15/hour and 50/day per IP (in the service) plus ASSISTANT_DAILY_CAP
# across the whole platform, and watch the usage in the Anthropic console.
# ANTHROPIC_MODEL picks a cheaper model without a code change, e.g.
# claude-haiku-4-5. A secret like the operator key: never commit a real one.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ASSISTANT_DAILY_CAP=300
