# Copy to .env and fill in — NEVER commit the real .env file.

# Required for POST /api/onchain/mint to work. Must be the private key of
# the wallet that owns HumfiverseCatalogueToken on Base Sepolia (see
# contracts/.env.example — same key). Testnet-only throwaway key, never
# real funds. Without this set, on-chain minting is disabled but the rest
# of the API still works.
CHAIN_OPERATOR_PRIVATE_KEY=

# Optional — defaults shown are what's already deployed.
CHAIN_RPC_URL=https://sepolia.base.org
CHAIN_CONTRACT_ADDRESS=0xFa9CCBCAAbd08f8f189249A82B0808dcb05e99c2

# Optional — HumfiverseMilestoneEscrow.sol address (see chainEscrow.js).
# Same CHAIN_OPERATOR_PRIVATE_KEY above is used for its owner-gated calls.
CHAIN_ESCROW_ADDRESS=0xbc220eB1234749a2127aad3deB69c689DC74C1a1
# Block the escrow contract above was deployed at — event-log scans start
# here instead of block 0 (see listCampaignAssetIdsFromChain in chainEscrow.js).
CHAIN_ESCROW_DEPLOY_BLOCK=46164128
