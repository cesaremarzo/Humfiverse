# Copy to .env and fill in — NEVER commit the real .env file.
#
# A throwaway testnet-only key. Do NOT reuse a wallet that holds real
# funds or is used on mainnet. Fund it with Sepolia testnet ETH from a
# faucet (e.g. https://sepoliafaucet.com or
# https://www.alchemy.com/faucets/ethereum-sepolia) before deploying —
# switched from Base Sepolia to real Ethereum Sepolia (§2.35) because
# Sepolia faucets are far easier to get testnet ETH from.
DEPLOYER_PRIVATE_KEY=

# Optional — defaults to a public Sepolia RPC if unset. Use your own
# Alchemy/Infura endpoint if the public one is rate-limited or
# unreliable (this project has repeatedly hit public-RPC rate limits —
# see planning/technical-architecture.md §2.13/§2.22).
SEPOLIA_RPC_URL=
