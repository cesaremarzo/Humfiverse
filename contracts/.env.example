# Copy to .env and fill in — NEVER commit the real .env file.
#
# A throwaway testnet-only key. Do NOT reuse a wallet that holds real
# funds or is used on mainnet. Fund it with testnet ETH from a Base
# Sepolia faucet (e.g. https://docs.base.org/tools/network-faucets/)
# before deploying.
DEPLOYER_PRIVATE_KEY=

# Optional — defaults to the public Base Sepolia RPC (https://sepolia.base.org)
# if unset. Use your own Alchemy/Infura endpoint if the public one is
# rate-limited or unreliable.
BASE_SEPOLIA_RPC_URL=
